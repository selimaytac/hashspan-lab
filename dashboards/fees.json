{
  "title": "hashspan-lab fees",
  "uid": "hashspan-lab-fees",
  "description": "Fees the agents paid, per chain and agent, from blockchain.client.fee and the confirm spans.",
  "tags": ["hashspan-lab"],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^(Prometheus|grafanacloud-.+-prom)$/"
      },
      {
        "name": "traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "regex": "/^(Tempo|grafanacloud-.+-traces)$/"
      },
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(blockchain_client_send_duration_seconds_count, job)",
          "refId": "job"
        },
        "definition": "label_values(blockchain_client_send_duration_seconds_count, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "About",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Totals in gwei. The metric is the total fee (execution plus L1 data fee); the L1 part is only on the confirm spans (`blockchain.tx.l1_fee`), shown in the table. Fees come from the sealed receipt, never a flashblocks preconfirmation (hashspan ADR 0024)."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Fees paid (time range)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (blockchain_chain_id) (max_over_time(blockchain_client_fee_sum{job=~\"$job\",blockchain_fee_payer=\"\"}[$__range])) / 1e9",
          "legendFormat": "chain {{blockchain_chain_id}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Transactions with a fee (time range)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (blockchain_chain_id) (max_over_time(blockchain_client_fee_count{job=~\"$job\",blockchain_fee_payer=\"\"}[$__range]))",
          "legendFormat": "chain {{blockchain_chain_id}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Average fee per transaction (time range)",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (blockchain_chain_id) (max_over_time(blockchain_client_fee_sum{job=~\"$job\",blockchain_fee_payer=\"\"}[$__range])) / sum by (blockchain_chain_id) (max_over_time(blockchain_client_fee_count{job=~\"$job\",blockchain_fee_payer=\"\"}[$__range])) / 1e9",
          "legendFormat": "chain {{blockchain_chain_id}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Fees per agent (gwei)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (max_over_time(blockchain_client_fee_sum{job=~\"$job\",blockchain_fee_payer=\"\"}[$__interval])) / 1e9",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Average fee per transaction, per agent (gwei)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "interval": "1h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (max_over_time(blockchain_client_fee_sum{job=~\"$job\",blockchain_fee_payer=\"\"}[$__interval])) / sum by (job) (max_over_time(blockchain_client_fee_count{job=~\"$job\",blockchain_fee_payer=\"\"}[$__interval])) / 1e9",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "id": 6
    },
    {
      "type": "table",
      "title": "Fees of confirm spans (wei)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "tempo",
        "uid": "${traces}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${traces}"
          },
          "refId": "A",
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 50,
          "query": "{span.blockchain.operation.name = \"confirm\" && span.blockchain.tx.fee != nil} | select(resource.service.name, span.blockchain.tx.fee, span.blockchain.tx.l1_fee, span.blockchain.tx.effective_gas_price, span.blockchain.tx.gas.used)"
        }
      ],
      "id": 7
    }
  ]
}
